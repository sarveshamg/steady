# Copy to .env.local
GOOGLE_CLOUD_PROJECT=steady-devfest
# Gemini 3.x models on Vertex are usually served from the global endpoint.
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

# Verify current IDs in Vertex Model Garden before the demo.
ANALYSIS_MODEL=gemini-3.8-flash
OMNI_MODEL=gemini-omni-1.1-flash

# Omni Flash costs real money. Leave false except when generating demo clips.
ENABLE_OMNI=false
OMNI_MAX_CALLS=10

# Optional: only if Omni Flash is not reachable through Vertex in your project.
# Create a key in Google AI Studio for project steady-devfest.
# GEMINI_API_KEY=

# Local businesses near the home (Google Maps Places API, New). Key restricted to "Places API (New)".
# GOOGLE_MAPS_API_KEY=

# Gemini text-to-speech for "Listen to this plan" (Vertex first; falls back to GEMINI_API_KEY if
# the model isn't available on Vertex). Check the TTS docs for the current model ID.
# TTS_MODEL=gemini-3.8-flash-tts
